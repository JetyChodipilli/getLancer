# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/.vinext/
/.sites-runtime/
/outputs/
/work/
/backend/target/
*.class
*.tsbuildinfo

# Local verification coordination
/.unlazy/
/.gstack/
test-results/
playwright-report/
/.ci-connected.json
/public/labs/
/labs/python/__pycache__/
/labs/data-ai/__pycache__/
/public/data-ai/
/.tooling/

/education/seeds/ai-ml/__pycache__/

# V5.1 generated material and native build output
/public/iot/
/public/frameworks/
/labs/dotnet/bin/
/labs/dotnet/obj/
/examples/frameworks/*/node_modules/
/examples/frameworks/*/dist/

/labs/dotnet/artifacts/
