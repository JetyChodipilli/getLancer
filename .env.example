SPRING_PROFILES_ACTIVE=local
APP_ENV=local
APP_BASE_URL=http://localhost:3000
BACKEND_URL=http://localhost:8080
DEMO_MODE=false
DB_URL=jdbc:postgresql://localhost:5432/getLancer
DB_USERNAME=postgres
DB_PASSWORD=REPLACE_WITH_LOCAL_SECRET
SECURE_COOKIES=false
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_AUTH=false
SMTP_TLS=false
EMAIL_FROM_ADDRESS=notifications@getlancer.local
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=getlancer
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY=REPLACE_WITH_LOCAL_ACCESS_KEY
OBJECT_STORAGE_SECRET_KEY=REPLACE_WITH_LOCAL_SECRET

# Optional local administrator: set an operator address before running setup.
ADMIN_EMAIL=
ADMIN_DISPLAY_NAME=Administrator
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_TOTP_SECRET=
# Backend only. setup-local generates an ephemeral 32-byte local key; never use it hosted.
MFA_ACTIVE_KEY_ID=
MFA_KEYRING=
RATE_LIMIT_PER_MINUTE=30
INDEX_PUBLIC_PAGES=false

# Backend only; register APP_BASE_URL/api/v1/auth/google/callback in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

JOBS_ENABLED=true

SMTP_SSL=false

GITHUB_CLIENT_ID=

GITHUB_CLIENT_SECRET=

# Dedicated app schema in your local PostgreSQL. Preserve the schema of existing installs.
DB_SCHEMA=getlancer
DB_POOL_MAX=10
SMTP_USERNAME=
SMTP_PASSWORD=
BACKEND_PROXY_SECRET=
AUTH_RATE_LIMIT_PER_MINUTE=10
EMAIL_RATE_LIMIT_PER_MINUTE=3
ANALYTICS_ENABLED=false
ANALYTICS_HASH_SALT=
ANALYTICS_RETENTION_DAYS=90
PUBLIC_RELIABILITY_MIN_SAMPLE=10
LEGAL_DOCUMENT_VERSION=v1-draft
POLICIES_APPROVED=false
SUPPORT_EMAIL=
PRIVACY_EMAIL=
COPYRIGHT_EMAIL=

# Browser-reachable signing endpoint for local object storage.
OBJECT_STORAGE_UPLOAD_ENDPOINT=http://localhost:9000

# V3: one Razorpay gateway. Enable only after commercial-policy and Route approval.
PAYMENTS_ENABLED=false
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_ROUTE_APPROVED=false

# Separate Razorpay webhook endpoint: /api/v1/commerce/razorpay/webhook.
RAZORPAY_COMMERCE_WEBHOOK_SECRET=
DISCOVERY_RATE_LIMIT_PER_MINUTE=300

# V4: verify subscriptions and routing of recurring payments before enabling.
MAINTENANCE_ENABLED=false
RAZORPAY_SUBSCRIPTIONS_APPROVED=false
RAZORPAY_MAINTENANCE_WEBHOOK_SECRET=
MAINTENANCE_RECONCILE_INTERVAL_MS=60000

# V4: enable only with a separately isolated static-demo publisher.
HOSTED_DEMOS_ENABLED=false
DEMO_PUBLISHER_URL=
DEMO_PUBLISHER_SECRET=
DEMO_GATEWAY_SECRET=
DEMO_PUBLIC_URL_TEMPLATE=
DEMO_EXPIRY_DAYS=7
DEMO_PUBLISHER_TIMEOUT_MS=5000
# Local Docker publisher is started only with COMPOSE_PROFILES=hosting.

# Hosted deployments inject environment values and explicitly select staging/production.
# DB_USERNAME=getlancer_runtime; migrations use separate getlancer_migration credentials
# outside the API process. DB_URL requires sslmode=verify-full and the provider CA.
# No migration password belongs in the runtime environment. See docs/DATABASE_RUNTIME_ROLES.md.
