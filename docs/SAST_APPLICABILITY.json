    {
      "path": "backend/src/main/java/com/getlancer/auth/GitHubAuthController.java",
      "startLine": 35,
      "score": 8.8,
      "ruleSha256": "4ef9cb422f69f73a288e4528fce32b4d117ec3679345a5d8a3c0e92bd289e9f8",
      "reason": "Provider callback GET requires unpredictable browser-bound state, exact provider and expiry, consumed atomically before exchange/session issuance. PKCE protects exchange; concurrent, later and failed-exchange replay cannot reuse state. Rejected callbacks preserve the pending browser binding."
    },
